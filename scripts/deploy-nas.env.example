# Copy to scripts/deploy-nas.env (gitignored) and fill in for your own host.
# scripts/deploy-nas.sh sources this file if it exists.

# SSH destination for the box that builds and runs the site.
# An ~/.ssh/config alias or user@host both work.
DEPLOY_SSH_HOST=

# Directory on that host the source tree is copied into before building.
# Replaced wholesale on every deploy, so give it a path of its own.
DEPLOY_SRC_DIR=

# Directory on that host holding the compose file for this site.
DEPLOY_STACK_DIR=

# Optional - these defaults match the committed Dockerfile and compose setup.
#DEPLOY_STACK_NAME=ohanalabs
#DEPLOY_IMAGE=ohanalabs:latest
#DEPLOY_SERVICE=web
#DEPLOY_SITE_URL=https://www.ohanalabs.app/
